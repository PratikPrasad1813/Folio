# Database (already configured in this sandbox)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public base URL used to build OAuth redirect URIs.
# In production set this to your deployed origin, e.g. https://folio.example.com
APP_URL=

# Optional social sign-in. Add credentials to enable the buttons on the sign-in page.
# Authorized redirect URIs:
#   {APP_URL}/api/auth/oauth/google/callback
#   {APP_URL}/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
